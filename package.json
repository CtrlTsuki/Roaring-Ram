{
  "name": "roaring-ram",
  "productName": "R.R.",
  "version": "0.1.0",
  "description": "R.R. (Roaring Ram): see where your RAM goes and take supported actions to reduce it.",
  "license": "MIT",
  "author": "CtrlTsuki",
  "repository": {
    "type": "git",
    "url": "https://github.com/CtrlTsuki/Roaring-Ram.git"
  },
  "homepage": "https://github.com/CtrlTsuki/Roaring-Ram",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "koffi": "^3.3.6"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.roaringram.rr",
    "productName": "R.R.",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "*.png"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**",
      "**/node_modules/@koromix/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "executableName": "RoaringRam"
    },
    "portable": {
      "artifactName": "RoaringRam-${version}-portable.exe"
    }
  }
}
